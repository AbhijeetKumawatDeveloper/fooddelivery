rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Restaurants collection:
    // Publicly readable for customer browsing
    // Only authenticated restaurant owners or admins can modify
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Foods collection:
    // Publicly readable so customers can view menus
    // Only authenticated restaurant owners or admins can create or modify
    match /foods/{foodId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0;
      allow delete: if isAuthenticated();
    }

    // User profiles:
    // Users can read/write their own profile; admins can audit & update status
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Orders collection:
    // - Customers can read their own orders.
    // - Restaurant owners can read and update orders for their own restaurant.
    // - Delivery partners can read and update orders assigned to them.
    // - Admins have governance visibility.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerId == request.auth.uid
      );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        (request.resource.data.status == 'pending' || !('status' in request.resource.data));

      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid ||
        get(/databases/$(database)/documents/restaurants/$(resource.data.restaurantId)).data.ownerId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }
  }
}
